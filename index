/* ── motore: nessun timer, decide la fisica ──
   Un'unità vale solo se al momento del pit sei sotto 0,50 g/L.
   Sopra il limite sei in sosta: quello che bevi non fa punti. */
function stato(p,ora=Date.now()){
  const d=[...(p.drinks||[])].sort((a,b)=>a.t-b.t);
  const r=p.sesso==="F"?0.55:0.68, peso=Math.max(35,+p.peso||70);
  let g=0,primo=null,alc=0,h2o=0,valide=0,perse=0,punti=0,sforato=false,unita=0;
  const segna=[];
  const bacA=t=>primo===null?0:Math.max(0,g/(peso*r)-DECAD*(t-primo)/3600e3);
  for(const x of d){
    const gr=+x.g||0;
    if(gr===0){h2o++;segna.push({...x,k:"h2o"});continue}
    if(bacA(x.t)>=LIMITE) sforato=true;
    segna.push({...x,k:"ok"});
    if(primo===null) primo=x.t;
    g+=gr; alc++; unita+=gr/12;
  }
  valide=alc;
  const bac=bacA(ora);
  if(bac>=LIMITE) sforato=true;
  punti+=Math.round(unita*10);
  punti+=Math.min(h2o*6,(alc+1)*6);
  const bonus=(p.bonus||[]).reduce((a,b)=>a+(+b.punti||0),0);
  punti+=bonus;
  const sc=alc===0&&h2o>=1;
  const bandiera=bac>=0.8?"nera":bac>=LIMITE?"rossa":bac>=0.2?"gialla":"verde";
  return {bac,punti,alc,h2o,unita,valide,perse,sforato,bandiera,sc,bonus,drinks:segna};
}

function radio(s,nome){
  const n=(nome||"").split(" ")[0].toUpperCase()||"PILOTA";
  if(s.sc) return `${n}, sei la safety car. Tutta la griglia stasera ti deve un caffè.`;
  if(s.bandiera==="nera") return `${n}, bandiera nera. Chiudiamo qui: acqua, qualcosa da mangiare, e le chiavi restano al box.`;
  if(s.bandiera==="rossa") return `${n}, sei in sosta: sopra 0,50 quello che bevi non fa più punti e soprattutto non guidi. Acqua e aspetta.`;
  if(s.bandiera==="gialla") return `${n}, gialla in settore due. Ancora in gara, ma il margine sul limite si sta chiudendo.`;
  if(s.alc===0) return `${n}, gomme fredde. La gara è lunga: il serbatoio si smaltisce a 0,15 g/L all'ora.`;
  return `${n}, ${s.valide} unità valide e ancora sotto il limite. Passo da campionato.`;
}
