  const n=document.getElementById("nastro"), inizio=s.drinks[0].t, durata=Math.max(Date.now()-inizio,45*60000);
  if(s.drinks.length===nTacche){
    n.querySelectorAll(".tacca").forEach((e,i)=>e.style.left=((s.drinks[i].t-inizio)/durata*100)+"%");
    return;
  }
  n.innerHTML='<div class="base"></div>';
  s.drinks.forEach(x=>{
    const d=document.createElement("div");
    d.className="tacca"+(x.k==="h2o"?" h2o":"");
