<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@500;600;700&family=Barlow:wght@400;500;600&family=JetBrains+Mono:wght@400;700;800&display=swap" rel="stylesheet">

<style>
:root{
  --asfalto:#12171a; --muretto:#1a2126; --muretto-alto:#222c32; --linea:#2b363d;
  --testo:#e8eef0; --testo-2:#8fa0a8; --testo-3:#5f7078;
  --box:#ff7a00; --acqua:#3aa9ff;
  --verde:#00d06c; --gialla:#f5c518; --rossa:#e1231e; --nera:#f2f2f0;
  --carta:#ece5d8; --carta-txt:#241f1a;
  --out:cubic-bezier(.23,1,.32,1); --inout:cubic-bezier(.77,0,.175,1);
  --mono:"JetBrains Mono",ui-monospace,monospace;
  --cond:"Barlow Condensed",system-ui,sans-serif;
  --body:"Barlow",system-ui,sans-serif;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;background:var(--asfalto);color:var(--testo);font-family:var(--body);overscroll-behavior-y:none}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
input{font:inherit}
.eyebrow{font-family:var(--cond);font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--testo-3)}

/* ══ scelta postazione ══ */
#scelta{min-height:100vh;display:flex;flex-direction:column;justify-content:center;padding:32px 22px;max-width:760px;margin:0 auto}
.marchio{font-family:var(--cond);font-weight:700;font-size:20px;letter-spacing:.02em;line-height:1}
.marchio em{font-style:normal;color:var(--box)}
.sotto{font-family:var(--cond);font-size:10px;letter-spacing:.22em;color:var(--testo-3);margin-top:2px}
#scelta .marchio{font-size:34px}
.postazioni{display:grid;gap:12px;margin-top:34px}
@media(min-width:700px){.postazioni{grid-template-columns:1fr 1fr}}
.post{background:var(--muretto);border:1px solid var(--linea);border-radius:16px;padding:22px;text-align:left;transition:transform 140ms var(--out),border-color 180ms ease}
.post:active{transform:scale(.985)}
.post h3{font-family:var(--cond);font-size:22px;letter-spacing:.06em;text-transform:uppercase;margin:10px 0 6px}
.post p{margin:0;font-size:14px;line-height:1.5;color:var(--testo-2)}
.post .k{font-size:26px}
@media(hover:hover){.post:hover{border-color:var(--box)}}

/* ══ telefono ══ */
#fisso{padding-bottom:calc(76px + env(safe-area-inset-bottom))}
header{position:sticky;top:0;z-index:20;background:var(--muretto);border-bottom:1px solid var(--linea);padding-top:env(safe-area-inset-top)}
#banda{height:3px;background:var(--verde);transition:background 320ms var(--inout)}
.testata{display:flex;align-items:center;justify-content:space-between;padding:10px 16px}
.conta{text-align:right;line-height:1.1}
.conta b{font-family:var(--mono);font-weight:800;font-size:17px}
main{padding:16px 16px 8px;max-width:520px;margin:0 auto}
.scheda{background:var(--muretto);border:1px solid var(--linea);border-radius:14px}
.hero{padding:18px}
.hero-riga{display:flex;align-items:flex-end;gap:14px}
#bac{font-family:var(--mono);font-weight:800;font-size:58px;line-height:.86;letter-spacing:-.03em;transition:color 320ms var(--inout)}
.hero-lato{flex:1;padding-bottom:6px}
.hero-lato .v{font-family:var(--mono);font-weight:700;font-size:19px;line-height:1.1}
.gauge{position:relative;height:8px;background:var(--asfalto);border-radius:99px;margin-top:16px;overflow:hidden}
#gaugeFill{position:absolute;inset:0 auto 0 0;width:0;background:var(--verde);border-radius:99px;transition:width 420ms var(--inout),background 320ms var(--inout)}
.limite{position:absolute;top:-4px;bottom:-4px;left:50%;width:2px;background:var(--testo);opacity:.55;border-radius:2px}
.gauge-lab{display:flex;justify-content:space-between;margin-top:6px}
.stato-riga{display:flex;align-items:center;gap:8px;padding-top:12px;margin-top:12px;border-top:1px solid var(--linea)}
.pallino{width:9px;height:9px;border-radius:2px;background:var(--verde);flex:none;transition:background 320ms var(--inout)}
#statoTesto{font-family:var(--cond);font-size:13px;letter-spacing:.1em;text-transform:uppercase;font-weight:600}
.radio{margin-top:12px;padding:14px 16px;border-left:3px solid var(--box);border-radius:0 14px 14px 0}
#radioTesto{font-size:15px;line-height:1.45;margin-top:5px}
#chiaviBtn{display:none;width:100%;margin-top:12px;padding:16px;border-radius:14px;background:var(--rossa);color:#fff;font-family:var(--cond);font-weight:700;font-size:15px;letter-spacing:.1em;text-transform:uppercase;transition:transform 140ms var(--out)}
#chiaviBtn:active{transform:scale(.98)}
#chiaviBtn.fatto{background:transparent;border:1px solid var(--verde);color:var(--verde)}
.sezione{margin-top:26px}
.sez-top{display:flex;align-items:center;justify-content:space-between}
.mini{font-family:var(--cond);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--testo-3);padding:6px 11px;border:1px solid var(--linea);border-radius:99px;transition:color 180ms ease,border-color 180ms ease}
.mini.on{color:var(--box);border-color:var(--box)}
.griglia{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:10px}
.drink{position:relative;background:var(--muretto);border:1px solid var(--linea);border-radius:12px;padding:12px 10px 11px;text-align:left;transition:transform 130ms var(--out),border-color 180ms ease,background 180ms ease}
.drink:active{transform:scale(.96);background:var(--muretto-alto)}
.drink .ico{font-size:21px;line-height:1}
.drink .n{font-family:var(--cond);font-weight:600;font-size:15px;letter-spacing:.04em;text-transform:uppercase;margin-top:8px;line-height:1.05}
.drink .s{font-family:var(--mono);font-size:10px;color:var(--testo-3);margin-top:4px}
.drink .u{position:absolute;top:9px;right:9px;font-family:var(--mono);font-size:10px;color:var(--testo-3)}
.drink.lampo{border-color:var(--box)}
.drink.nuova{border-style:dashed;color:var(--testo-3);display:flex;align-items:center;justify-content:center;min-height:88px;font-family:var(--cond);letter-spacing:.1em;text-transform:uppercase;font-size:13px}
body.modifica .drink[data-b]{border-color:var(--box)}
#acquaBtn{width:100%;margin-top:8px;padding:15px;border-radius:12px;background:var(--muretto);border:1px solid rgba(58,169,255,.35);color:var(--acqua);font-family:var(--cond);font-weight:600;font-size:14px;letter-spacing:.14em;text-transform:uppercase;transition:transform 130ms var(--out)}
#acquaBtn:active{transform:scale(.98)}
#annullaBtn{display:none;width:100%;margin-top:8px;padding:12px;border-radius:12px;border:1px solid var(--linea);font-family:var(--cond);font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:var(--testo-3)}
.nastro-wrap{margin-top:10px;background:var(--muretto);border:1px solid var(--linea);border-radius:12px;padding:14px 14px 10px}
.nastro{position:relative;height:56px}
.nastro .base{position:absolute;left:0;right:0;top:28px;height:1px;background:var(--linea)}
.tacca{position:absolute;top:0;bottom:0;display:flex;flex-direction:column;align-items:center;justify-content:center;transform:translateX(-50%)}
.tacca i{display:block;width:2px;height:22px;background:var(--box);border-radius:2px;animation:cresci 260ms var(--out) both}
.tacca.h2o i{background:var(--acqua)}
.tacca b{font-family:var(--mono);font-size:9px;font-weight:400;color:var(--testo-3);margin-top:6px;white-space:nowrap}
@keyframes cresci{from{transform:scaleY(.2);opacity:0}to{transform:scaleY(1);opacity:1}}
.testina{position:absolute;top:2px;bottom:2px;width:1px;background:var(--testo);opacity:.35}
.gps{margin-top:12px;padding:14px 16px;display:flex;align-items:center;gap:14px}
.gps .txt{flex:1;min-width:0}
#gpsStato{font-size:13px;color:var(--testo-2);margin-top:3px;line-height:1.35}
.switch{width:50px;height:29px;border-radius:99px;background:var(--asfalto);border:1px solid var(--linea);position:relative;flex:none;transition:background 200ms ease,border-color 200ms ease}
.switch i{position:absolute;top:3px;left:3px;width:21px;height:21px;border-radius:99px;background:var(--testo-3);transition:transform 220ms var(--out),background 200ms ease}
.switch.on{background:rgba(0,208,108,.18);border-color:var(--verde)}
.switch.on i{transform:translateX(21px);background:var(--verde)}
.riga{display:flex;align-items:stretch;border-bottom:1px solid var(--linea);background:var(--muretto)}
.riga:first-child{border-radius:14px 14px 0 0}
.riga:last-child{border-bottom:none;border-radius:0 0 14px 14px}
.riga.io{background:var(--muretto-alto)}
.riga .flag{width:4px;flex:none}
.riga .pos{width:34px;flex:none;display:flex;align-items:center;justify-content:center;font-family:var(--mono);font-weight:700;font-size:14px;color:var(--testo-3)}
.riga .mid{flex:1;min-width:0;padding:12px 8px 12px 2px}
.riga .nome{font-family:var(--cond);font-weight:600;font-size:16px;letter-spacing:.03em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.riga.io .nome{color:var(--box)}
.riga .dett{font-family:var(--mono);font-size:11px;color:var(--testo-3);margin-top:3px}
.riga .punti{width:78px;flex:none;text-align:right;padding:12px 14px 12px 0}
.riga .punti b{font-family:var(--mono);font-weight:800;font-size:19px;line-height:1}
.riga .punti span{display:block;font-family:var(--mono);font-size:11px;color:var(--testo-3);margin-top:2px}
.tag{display:inline-block;font-family:var(--cond);font-size:10px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;padding:1px 5px;border-radius:4px;margin-left:6px;background:rgba(0,208,108,.14);color:var(--verde)}
.vuoto{text-align:center;padding:46px 20px;color:var(--testo-3);font-size:14px;line-height:1.5}
.vuoto b{display:block;font-family:var(--cond);font-size:17px;letter-spacing:.08em;text-transform:uppercase;color:var(--testo-2);margin-bottom:6px}
.foglio{background:var(--carta);color:var(--carta-txt);border-radius:14px;padding:22px 20px 24px;box-shadow:0 10px 30px rgba(0,0,0,.35)}
.foglio h2{font-family:var(--cond);font-size:12px;letter-spacing:.2em;text-transform:uppercase;margin:0 0 2px;color:#8a7f6d}
.foglio h1{font-family:var(--cond);font-size:26px;letter-spacing:.02em;text-transform:uppercase;margin:0 0 16px;line-height:1}
.foglio .art{font-family:var(--cond);font-size:11px;letter-spacing:.18em;text-transform:uppercase;color:#8a7f6d;margin:22px 0 6px;border-bottom:1px solid rgba(0,0,0,.18);padding-bottom:4px}
.rg{display:flex;justify-content:space-between;gap:14px;padding:8px 0;border-bottom:1px dotted rgba(0,0,0,.18);font-size:14px;line-height:1.35}
.rg b{font-family:var(--mono);font-weight:700;flex:none}
.rg b.neg{color:#a01410}.rg b.pos{color:#1c7a3f}
.foglio p{font-size:13.5px;line-height:1.55;margin:10px 0 0;color:#3a332b}
.timbro{margin-top:22px;border:2px solid #a01410;color:#a01410;border-radius:8px;padding:10px 12px;transform:rotate(-1.2deg);font-family:var(--cond);font-size:13px;letter-spacing:.06em;text-transform:uppercase;line-height:1.3;text-align:center}
#esciBtn{width:100%;margin-top:16px;padding:13px;border-radius:12px;border:1px solid var(--linea);color:var(--testo-3);font-family:var(--cond);font-size:12px;letter-spacing:.16em;text-transform:uppercase}
nav{position:fixed;left:0;right:0;bottom:0;z-index:20;display:flex;background:var(--muretto);border-top:1px solid var(--linea);padding-bottom:env(safe-area-inset-bottom)}
nav button{flex:1;padding:16px 4px 15px;font-family:var(--cond);font-size:11px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--testo-3);position:relative;transition:color 180ms ease}
nav button::after{content:"";position:absolute;top:-1px;left:50%;width:0;height:2px;background:var(--box);transform:translateX(-50%);transition:width 220ms var(--out)}
nav button.on{color:var(--box)}
nav button.on::after{width:38px}
#iscrizione{padding:44px 22px calc(40px + env(safe-area-inset-bottom));max-width:520px;margin:0 auto}
#iscrizione .marchio{font-size:30px}
.campo{display:block;margin-top:20px}
.campo .eyebrow{display:block;margin-bottom:7px}
.campo input{width:100%;background:var(--muretto);border:1px solid var(--linea);border-radius:12px;padding:15px 14px;color:var(--testo);font-family:var(--mono);font-size:17px;outline:none;transition:border-color 180ms ease}
.campo input:focus{border-color:var(--box)}
.coppia{display:flex;gap:8px;margin-top:7px}
.coppia button{flex:1;padding:14px;border-radius:12px;border:1px solid var(--linea);font-family:var(--cond);font-size:14px;letter-spacing:.1em;text-transform:uppercase;color:var(--testo-2);transition:border-color 180ms ease,color 180ms ease}
.coppia button.on{border-color:var(--box);color:var(--box)}
#viaBtn{width:100%;margin-top:28px;padding:17px;border-radius:12px;background:var(--box);color:#160c00;font-family:var(--cond);font-weight:700;font-size:15px;letter-spacing:.16em;text-transform:uppercase;transition:transform 140ms var(--out)}
#viaBtn:active{transform:scale(.98)}
#viaBtn[disabled]{background:var(--muretto);color:var(--testo-3);cursor:default}
.nota{font-size:13.5px;line-height:1.5;color:var(--testo-2);margin-top:18px}
#velo{position:fixed;inset:0;z-index:40;background:rgba(6,9,11,.72);opacity:0;pointer-events:none;transition:opacity 200ms ease}
#velo.on{opacity:1;pointer-events:auto}
#sheet{position:fixed;left:0;right:0;bottom:0;z-index:41;background:var(--muretto);border-top:1px solid var(--linea);border-radius:18px 18px 0 0;padding:18px 20px calc(20px + env(safe-area-inset-bottom));transform:translateY(102%);transition:transform 340ms cubic-bezier(.32,.72,0,1);max-width:520px;margin:0 auto;max-height:88vh;overflow:auto}
#sheet.on{transform:translateY(0)}
.maniglia{width:38px;height:4px;border-radius:99px;background:var(--linea);margin:0 auto 14px}
#sheet h3{font-family:var(--cond);font-size:21px;letter-spacing:.05em;text-transform:uppercase;margin:0 0 4px}
.riga2{display:flex;gap:8px;margin-top:14px}
.riga2>*{flex:1;margin:0}
.anteprima{margin-top:16px;padding:12px 14px;background:var(--asfalto);border-radius:12px;display:flex;justify-content:space-between;align-items:center}
.anteprima b{font-family:var(--mono);font-weight:700;font-size:16px;color:var(--box)}
.sheet-btn{width:100%;margin-top:10px;padding:16px;border-radius:12px;font-family:var(--cond);font-weight:700;font-size:14px;letter-spacing:.14em;text-transform:uppercase;transition:transform 140ms var(--out)}
.sheet-btn:active{transform:scale(.98)}
.sheet-btn.primo{background:var(--box);color:#160c00}
.sheet-btn.primo[disabled]{background:var(--muretto-alto);color:var(--testo-3)}
.sheet-btn.dopo{border:1px solid var(--linea);color:var(--testo-2)}
.sheet-btn.rosso{border:1px solid var(--rossa);color:var(--rossa)}
#toast{position:fixed;left:16px;right:16px;bottom:calc(88px + env(safe-area-inset-bottom));z-index:50;max-width:488px;margin:0 auto;background:var(--muretto-alto);border:1px solid var(--linea);border-radius:12px;padding:13px 15px;display:flex;justify-content:space-between;align-items:center;gap:12px;opacity:0;transform:translateY(10px) scale(.97);pointer-events:none;transition:opacity 200ms var(--out),transform 200ms var(--out)}
#toast.on{opacity:1;transform:none}
#toast .tt{font-family:var(--cond);font-size:14px;letter-spacing:.08em;text-transform:uppercase}
#toast .pp{font-family:var(--mono);font-weight:700;font-size:15px}
.gruppo>*{animation:entra 300ms var(--out) both}
.gruppo>*:nth-child(2){animation-delay:40ms}.gruppo>*:nth-child(3){animation-delay:80ms}.gruppo>*:nth-child(4){animation-delay:120ms}
@keyframes entra{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}

/* ══ sfide a sorpresa ══ */
#sfidaBox{max-width:520px;margin:0 auto;padding:0 16px}
.sfida{margin-top:16px;border-radius:14px;border:1px solid;padding:16px;background:var(--muretto);animation:sfidaEntra 380ms var(--out) both}
@keyframes sfidaEntra{from{opacity:0;transform:translateY(-10px) scale(.98)}to{opacity:1;transform:none}}
.sfida .cap{display:flex;justify-content:space-between;align-items:baseline;gap:10px}
.sfida .tit{font-family:var(--cond);font-weight:700;font-size:19px;letter-spacing:.08em;text-transform:uppercase;line-height:1}
.sfida .cd{font-family:var(--mono);font-weight:800;font-size:19px;flex:none}
.sfida .des{font-size:14.5px;line-height:1.45;color:var(--testo-2);margin-top:8px}
.sfida .barra{height:4px;background:var(--asfalto);border-radius:99px;margin-top:12px;overflow:hidden}
.sfida .barra i{display:block;height:100%;border-radius:99px;transition:width 900ms linear}
.sfida .esito{margin-top:12px;padding-top:11px;border-top:1px solid var(--linea);font-family:var(--cond);font-size:14px;letter-spacing:.08em;text-transform:uppercase}
.opz{display:block;width:100%;margin-top:8px;padding:14px;border-radius:11px;border:1px solid var(--linea);text-align:left;font-size:15px;transition:transform 130ms var(--out),border-color 160ms ease}
.opz:active{transform:scale(.985)}
.opz.giusta{border-color:var(--verde);color:var(--verde)}
.opz.sbagliata{border-color:var(--rossa);color:var(--rossa)}
.opz[disabled]{opacity:.5}
.luci{display:flex;gap:8px;justify-content:center;margin-top:14px}
.luci i{width:34px;height:34px;border-radius:99px;background:#2b363d;box-shadow:inset 0 0 0 1px rgba(255,255,255,.05);transition:background 90ms linear,box-shadow 90ms linear}
.luci i.on{background:var(--rossa);box-shadow:0 0 18px rgba(225,35,30,.7)}
.audio{font-family:var(--cond);font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--testo-3);border:1px solid var(--linea);border-radius:99px;padding:6px 11px;transition:color 160ms ease,border-color 160ms ease}
.audio.spento{color:var(--rossa);border-color:var(--rossa)}
.testata .destra{display:flex;align-items:center;gap:12px}

/* ══ muretto (PC) ══ */
#muretto{display:none;height:100vh;flex-direction:column;overflow:hidden}
#mwSfida{display:none;flex:none;align-items:center;gap:26px;padding:14px 26px;border-bottom:1px solid var(--linea);background:var(--muretto-alto)}
#mwSfida.on{display:flex}
#mwSfida .tit{font-family:var(--cond);font-weight:700;font-size:30px;letter-spacing:.08em;text-transform:uppercase;line-height:1;flex:none}
#mwSfida .des{flex:1;min-width:0;font-size:15px;color:var(--testo-2);line-height:1.35}
#mwSfida .cd{font-family:var(--mono);font-weight:800;font-size:38px;line-height:1;flex:none}
#mwLancia{font-family:var(--cond);font-weight:700;font-size:12px;letter-spacing:.16em;text-transform:uppercase;border:1px solid var(--box);color:var(--box);border-radius:99px;padding:9px 15px;transition:background 160ms ease,color 160ms ease}
@media(hover:hover){#mwLancia:hover{background:var(--box);color:#160c00}}
#muretto.on{display:flex}
.mw-top{display:flex;align-items:center;justify-content:space-between;padding:14px 26px;border-bottom:1px solid var(--linea);background:var(--muretto);flex:none}
.mw-top .marchio{font-size:24px}
.mw-stat{display:flex;gap:34px;align-items:center}
.mw-stat div{text-align:right}
.mw-stat b{display:block;font-family:var(--mono);font-weight:800;font-size:24px;line-height:1.15}
.mw-corpo{flex:1;display:grid;grid-template-columns:minmax(0,1.15fr) minmax(0,1fr);gap:1px;background:var(--linea);min-height:0}
@media(max-width:1000px){.mw-corpo{grid-template-columns:1fr;grid-template-rows:1fr 1fr}}
.mw-pan{background:var(--asfalto);display:flex;flex-direction:column;min-height:0}
.mw-lab{padding:11px 22px;border-bottom:1px solid var(--linea);display:flex;justify-content:space-between;align-items:center;flex:none}
.mw-scroll{flex:1;overflow:auto;min-height:0}
.mwr{display:flex;align-items:center;border-bottom:1px solid var(--linea);height:64px}
.mwr .fl{width:6px;height:100%;flex:none}
.mwr .p{width:56px;flex:none;text-align:center;font-family:var(--mono);font-weight:800;font-size:22px;color:var(--testo-3)}
.mwr.p1 .p{color:var(--box)}
.mwr .nm{flex:1;min-width:0;padding-right:12px}
.mwr .nm b{display:block;font-family:var(--cond);font-weight:700;font-size:25px;letter-spacing:.03em;text-transform:uppercase;line-height:1.05;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
