/* ── GPS ── */
function mostraAgg(v){const b=document.getElementById("gpsAgg");if(b)b.style.display=v?"inline-block":"none"}

function chiediPosizione(silenzioso){
  const st=document.getElementById("gpsStato"), sw=document.getElementById("gpsSw");
  if(!navigator.geolocation){ if(st) st.textContent="Questo browser non espone la posizione."; return; }
  if(st&&!silenzioso) st.textContent="Richiesta in corso…";
  navigator.geolocation.getCurrentPosition(async pos=>{
    const {latitude:lat,longitude:lng,accuracy:acc}=pos.coords, ora=Date.now();
    ultimaPos={lat,lng,acc}; ultimoInvio=ora; gpsId=1;
    if(sw) sw.classList.add("on");
    await salva({...io,gps:{lat,lng,acc,t:ora},updated:ora});
    if(st) st.textContent=`Condivisa · precisione ${Math.round(acc)} m · rilevata ${oraDi(ora)}`+(diagErr?" · ARCHIVIO KO":"");
    mostraAgg(true);
  },err=>{
    if(!silenzioso){ gpsId=null; if(sw) sw.classList.remove("on"); }
    if(st) st.textContent=err.code===1
      ? "Permesso negato (codice 1). Se sei nell'anteprima della chat il riquadro blocca il GPS: apri il file in una scheda del browser."
      : err.code===2 ? "Nessun fix disponibile (codice 2). Prova all'aperto o accendi la localizzazione di sistema."
      : "Tempo scaduto (codice 3). Tocca Aggiorna per riprovare.";
  },{enableHighAccuracy:true,maximumAge:0,timeout:25000});
}

function accendiGps(){
  chiediPosizione(false);
  clearInterval(gpsBattito);
  gpsBattito=setInterval(()=>{ if(gpsId&&io) chiediPosizione(true) },5*60e3);
}

async function spegniGps(){
  clearInterval(gpsBattito); ultimaPos=null; gpsId=null; mostraAgg(false);
  const sw=document.getElementById("gpsSw"), st=document.getElementById("gpsStato");
  if(sw) sw.classList.remove("on");
  if(st) st.textContent="Spenta. Accendila e comparirai sulla mappa del muretto.";
  if(io&&io.gps) await salva({...io,gps:null,updated:Date.now()});
}

/* ══ MURETTO ══ */
function avviaMuretto(){
  const cv=document.getElementById("mappa");
  const ridimensiona=()=>{
    const r=cv.getBoundingClientRect(), d=window.devicePixelRatio||1;
    cv.width=Math.max(1,r.width*d); cv.height=Math.max(1,r.height*d);
    cv.getContext("2d").setTransform(d,0,0,d,0,0);
    disegnaMappa();
  };
  window.addEventListener("resize",ridimensiona);
  setTimeout(ridimensiona,80);
  tieniSveglio(true);
  document.getElementById("mwLancia").addEventListener("click",lanciaOra);
  document.getElementById("mwProva").addEventListener("click",async()=>{
    const nomi=["Collaudatore","Muletto","Terza guida","Riserva"];
    const n=nomi[Math.floor(Math.random()*nomi.length)]+" "+Math.floor(Math.random()*90+10);
    const id="prova_"+Date.now().toString(36);
    const g=(await leggi(K_GRIGLIA,true))||{};
    g[id]={id,nome:n,peso:75,sesso:"M",prova:true,nato:Date.now()-3600e3,
      drinks:[{t:Date.now()-2400e3,tipo:"birra33",nome:"Birra 33",g:13},
              {t:Date.now()-900e3,tipo:"acqua",nome:"Acqua",g:0}],
      bonus:[],chiavi:false,
      gps:{lat:VARANO.lat+(Math.random()-.5)*.004,lng:VARANO.lng+(Math.random()-.5)*.004,acc:12,t:Date.now()},
      updated:Date.now()};
    const ok=await scrivi(K_GRIGLIA,g,true);
    await sincronizza();
    if(!ok) alert("Scrittura sull'archivio condiviso fallita:\n"+diagErr);
  });
  document.getElementById("mwPulisci").addEventListener("click",async()=>{
    const g=(await leggi(K_GRIGLIA,true))||{};
    for(const k of Object.keys(g)) if(g[k].prova) delete g[k];
    await scrivi(K_GRIGLIA,g,true); await sincronizza();
  });
  const ma=document.getElementById("mwAudio");
  ma.addEventListener("click",()=>{
    muto=!muto; ma.classList.toggle("spento",muto); ma.textContent=muto?"🔇":"🔊";
    if(!muto){ sbloccaAudio(); suona("ok"); }
  });
  setInterval(()=>{document.getElementById("mwOra").textContent=new Date().toLocaleTimeString("it-IT",{hour:"2-digit",minute:"2-digit"})},1000);
  disegnaMuretto();
}

function disegnaMuretto(){
  const righe=classifica();
  const dg=document.getElementById("mwDiag");
  if(dg){
    const conGps=Object.values(griglia).filter(p=>p.gps).length;
    dg.innerHTML = diagErr
      ? `<span style="color:var(--rossa)">ARCHIVIO KO · ${esc(diagErr).slice(0,60)}</span>`
      : `archivio ok · ${diagLetto} record · ${conGps} con gps · sync ${diagSync?oraDi(diagSync):"—"}`;
  }
  document.getElementById("mwN").textContent=righe.length;
  document.getElementById("mwU").textContent=righe.reduce((a,r)=>a+r.s.alc,0);
  document.getElementById("mwOk").textContent=righe.filter(r=>r.s.bac<LIMITE).length;

  const c=document.getElementById("mwTorre");
  if(!righe.length){
    c.innerHTML=`<div class="vuoto"><b>Griglia vuota</b>${diagErr
      ? "L'archivio condiviso risponde con un errore: "+esc(diagErr)
      : "Nessun pilota registrato nell'archivio condiviso.<br>Sul telefono serve aprire lo stesso link, scegliere <b>Sono un pilota</b> e completare il foglio iscrizioni.<br>Con <b>+ pilota di prova</b> qui sopra verifichi che il canale funzioni."}</div>`;
  }else{
    const prima=new Map(); c.querySelectorAll(".mwr").forEach(e=>prima.set(e.dataset.id,e.getBoundingClientRect().top));
    c.innerHTML=righe.map((r,i)=>{
      const b=BANDIERE[r.s.bandiera], cc=col(b.c);
      return `<div class="mwr${i===0?" p1":""}" data-id="${r.p.id}">
        <div class="fl" style="background:${cc}"></div><div class="p">${i+1}</div>
        <div class="nm"><b>${esc(r.p.nome)}${r.s.sc?" · SC":""}${r.p.chiavi?" 🔑":""}</b>
        <span>${b.testo} · ${r.s.alc} bicchieri${r.p.gps?" · gps":""}</span></div>
        <div class="col"><i>Unità</i><b>${r.s.unita.toFixed(1)}</b></div>
        <div class="col"><i>g/L</i><b style="color:${cc}">${r.s.bac.toFixed(2)}</b></div>
        <div class="col"><i>Punti</i><b>${r.s.punti}</b></div></div>`;
    }).join("");
    if(!matchMedia("(prefers-reduced-motion: reduce)").matches)
      c.querySelectorAll(".mwr").forEach(e=>{
        const p=prima.get(e.dataset.id); if(p===undefined) return;
        const d=p-e.getBoundingClientRect().top; if(!d) return;
        e.animate([{transform:`translateY(${d}px)`},{transform:"none"}],{duration:420,easing:"cubic-bezier(.77,0,.175,1)"});
      });
  }

  const ev=[];
  for(const {p,s} of righe) for(const d of s.drinks) ev.push({t:d.t,chi:p.nome,cosa:d.nome||"Pit stop",k:d.k,u:(+d.g||0)/12});
  ev.sort((a,b)=>b.t-a.t);
  document.getElementById("mwFeed").innerHTML=ev.slice(0,14).map(e=>
    `<div class="fev"><span class="o">${oraDi(e.t)}</span><span class="w">${esc(e.chi)} · ${esc(e.cosa)}</span>
     <span class="d" style="color:${e.k==="h2o"?"var(--acqua)":"var(--verde)"}">${e.k==="h2o"?"+6":"+"+Math.round(e.u*10)}</span></div>`
  ).join("")||`<div class="vuoto" style="padding:26px">Nessun pit stop registrato.</div>`;

  disegnaMappa();
}

function disegnaMappa(){
  const cv=document.getElementById("mappa"); if(!cv||!cv.width) return;
  const g=cv.getContext("2d"), W=cv.clientWidth, H=cv.clientHeight;
  g.clearRect(0,0,W,H);
  const punti=Object.values(griglia).filter(p=>p.gps&&Date.now()-p.gps.t<3600e3);
  const lab=document.getElementById("mwScala");
  if(!punti.length){
    g.fillStyle="#5f7078"; g.font='500 14px "Barlow",sans-serif'; g.textAlign="center";
    g.fillText("Nessuna posizione condivisa.",W/2,H/2-8);
    g.fillText("I piloti accendono il GPS dalla scheda del proprio box.",W/2,H/2+14);
    lab.textContent="—"; return;
  }
  const cLat=punti.reduce((a,p)=>a+p.gps.lat,0)/punti.length;
  const cLng=punti.reduce((a,p)=>a+p.gps.lng,0)/punti.length;
  const mLat=111320, mLng=111320*Math.cos(cLat*Math.PI/180);
  const xy=p=>({x:(p.gps.lng-cLng)*mLng,y:-(p.gps.lat-cLat)*mLat});
  let raggio=60;
  punti.forEach(p=>{const q=xy(p);raggio=Math.max(raggio,Math.hypot(q.x,q.y)*1.35)});
  const scala=Math.min(W,H)/2/raggio*0.84, cx=W/2, cy=H/2;

  const passo=Math.pow(10,Math.floor(Math.log10(raggio)));
  g.strokeStyle="#2b363d"; g.lineWidth=1;
  g.fillStyle="#5f7078"; g.font='400 10px "JetBrains Mono",monospace'; g.textAlign="left";
  for(let r=passo;r<=raggio;r+=passo){
    g.beginPath(); g.arc(cx,cy,r*scala,0,Math.PI*2); g.stroke();
    g.fillText(r>=1000?(r/1000)+" km":r+" m",cx+5,cy-r*scala-5);
  }
  g.setLineDash([2,6]); g.beginPath();
  g.moveTo(0,cy); g.lineTo(W,cy); g.moveTo(cx,0); g.lineTo(cx,H); g.stroke(); g.setLineDash([]);

  punti.forEach(p=>{
    const s=stato(p), cc=col(BANDIERE[s.bandiera].c), q=xy(p);
    const x=cx+q.x*scala, y=cy+q.y*scala;
    g.globalAlpha=Date.now()-p.gps.t>10*60e3?.45:1;
    g.beginPath(); g.arc(x,y,14,0,Math.PI*2); g.fillStyle=cc+"22"; g.fill();
    g.beginPath(); g.arc(x,y,5,0,Math.PI*2); g.fillStyle=cc; g.fill();
    g.textAlign="center";
    g.fillStyle="#e8eef0"; g.font='600 13px "Barlow Condensed",sans-serif';
    g.fillText(String(p.nome).toUpperCase(),x,y-19);
    g.fillStyle="#5f7078"; g.font='400 10px "JetBrains Mono",monospace';
    g.fillText(oraDi(p.gps.t),x,y+25);
    g.globalAlpha=1;
  });

  const dV=Math.round(Math.hypot((cLng-VARANO.lng)*mLng,(cLat-VARANO.lat)*mLat));
  lab.textContent=`${punti.length} in mappa · centro a ${dV>=1000?(dV/1000).toFixed(1)+" km":dV+" m"} dall'autodromo`;
}

/* ══ SFIDE A SORPRESA ══
   Tipo, momento e domanda derivano dal timestamp: tutti i telefoni
   generano la stessa sfida senza bisogno di un arbitro. */
function generaSfida(quando){
  const k=CHIAVI_TIPI[Math.floor(rnd(quando/1000)*CHIAVI_TIPI.length)];
  const t=TIPI[k];
  const s={id:"s"+quando,tipo:k,inizio:quando,fine:quando+t.durata};
  if(t.banco) s.v=Math.floor(rnd(quando/1000+7)*BANCHI[t.banco].length);
  s.prossima=s.fine+Math.floor(rnd(s.fine/1000)*8+7)*60e3;
  return s;
}
async function ciclaSfide(){
  const ora=Date.now();
  let s=await leggi(K_SFIDA,true);
  if(!s){ s={id:"s0",tipo:"veloce",inizio:0,fine:0,prossima:ora+5*60e3}; await scrivi(K_SFIDA,s,true); }
  if(ora>=s.fine && ora>=s.prossima){
    s=generaSfida(Math.floor(s.prossima/1000)*1000);
    await scrivi(K_SFIDA,s,true);
  }
  sfida=s;
  if(s.inizio && s.id!==suonata && ora<s.fine && ora-s.inizio<40e3){
    suonata=s.id; suona("sfida");
    if(navigator.vibrate) navigator.vibrate([30,70,30,70,120]);
    svegliaRiposo();
  }
  if(modo==="pilota"&&io) valuta(s);
  disegnaSfida();
}
async function lanciaOra(){
  sfida=generaSfida(Math.floor(Date.now()/1000)*1000);
  await scrivi(K_SFIDA,sfida,true);
  suonata=sfida.id; suona("sfida"); disegnaSfida();
}

const preso=(p,id)=>(p.bonus||[]).some(b=>b.sfida===id);
async function premia(id,punti,motivo){
  if(preso(io,id)) return;
  await salva({...io,bonus:[...(io.bonus||[]),{sfida:id,punti,motivo,t:Date.now()}],updated:Date.now()});
  suona(punti>0?"ok":"no");
  toast(motivo,(punti>0?"+":"")+punti);
  if(tab==="box") disegnaBox();
  disegnaSfida();
}

function valuta(s){
  if(!s||!s.inizio||preso(io,s.id)) return;
  if(io.nato&&io.nato>s.inizio) return;
  const ora=Date.now(), st=stato(io);
  const dentro=st.drinks.filter(d=>d.t>=s.inizio&&d.t<=s.fine);
  if(s.tipo==="veloce"&&dentro.some(d=>d.k==="ok")) premia(s.id,10,"Giro veloce: pit stop doppio");
  if(s.tipo==="acqua"&&dentro.some(d=>d.k==="h2o")) premia(s.id,12,"Rifornimento completato");
  if(s.tipo==="undercut"&&st.bac<0.2&&ora<=s.fine) premia(s.id,15,"Undercut riuscito");
  if(ora>s.fine){
    if(s.tipo==="safety") premia(s.id, dentro.some(d=>d.k!=="h2o")?0:20,
      dentro.some(d=>d.k!=="h2o")?"Safety car non rispettata":"Safety car rispettata");
    if(s.tipo==="undercut"&&st.bac>=0.2) premia(s.id,0,"Undercut mancato");
  }
}

/* domanda costruita sulla griglia viva */
function domandaGriglia(){
  const r=classifica().filter(x=>x.s.alc>0||x.s.h2o>0);
  if(r.length<3) return null;
  const nomi=r.slice(0,6).map(x=>x.p.nome);
  const giusto=r[0].p.nome;
  const altri=nomi.filter(n=>n!==giusto).slice(0,2);
  const o=[giusto,...altri];
  return {d:"Chi è primo in classifica in questo momento?",o,r:0};
}

async function rispondi(i,btn,q){
  document.querySelectorAll(".opz").forEach(b=>b.disabled=true);
  const ok=q.o[i]===q.o[q.r];
  btn.classList.add(ok?"giusta":"sbagliata");
  const g=document.querySelectorAll(".opz")[q.r]; if(g) g.classList.add("giusta");
  await premia(sfida.id, ok?25:0, ok?"Risposta esatta":"Risposta errata");
}

/* mini gioco: partenza a semaforo */
function semaforo(host){
  giocoAttivo=true;
  host.innerHTML=`<div class="luci">${"<i></i>".repeat(5)}</div>
    <button class="opz" id="rzGo" style="text-align:center">Pronto — tocca per accendere</button>
    <div class="des" id="rzMsg">Cinque luci, poi buio. Tocca appena si spengono.</div>`;
  const luci=[...host.querySelectorAll(".luci i")], go=host.querySelector("#rzGo"), msg=host.querySelector("#rzMsg");
  let fase="attesa", t0=0, timers=[];
  const pulisci=()=>timers.forEach(clearTimeout);
  go.addEventListener("click",async()=>{
    if(fase==="attesa"){
      fase="accende"; go.textContent="Attento…"; msg.textContent="Non anticipare.";
      luci.forEach((l,i)=>timers.push(setTimeout(()=>{l.classList.add("on");suona("luce")},(i+1)*900)));
      timers.push(setTimeout(()=>{
        fase="pronto";
        timers.push(setTimeout(()=>{
          luci.forEach(l=>l.classList.remove("on")); suona("via");
          fase="via"; t0=performance.now(); go.textContent="ORA!";
        }, 600+Math.random()*2600));
      },5*900));
      return;
    }
    if(fase==="accende"||fase==="pronto"){
      pulisci(); fase="fine"; suona("anticipo");
      luci.forEach(l=>l.classList.remove("on"));
      go.textContent="Partenza anticipata"; giocoAttivo=false;
      await premia(sfida.id,0,"Semaforo: partenza anticipata");
      return;
    }
    if(fase==="via"){
      const ms=Math.round(performance.now()-t0); fase="fine"; giocoAttivo=false;
      const p= ms<250?25 : ms<400?18 : ms<600?10 : 5;
      go.textContent=ms+" millesimi";
      await premia(sfida.id,p,`Semaforo: ${ms} ms`);
    }
  });
}

function mmss(ms){
  const s=Math.max(0,Math.round(ms/1000));
  return String(Math.floor(s/60)).padStart(2,"0")+":"+String(s%60).padStart(2,"0");
}
function testoSfida(s){
  const t=TIPI[s.tipo];
  if(s.tipo==="quiz") return QUIZ[s.v||0].d;
  if(s.tipo==="prova") return PROVE[s.v||0];
  if(s.tipo==="regime") return REGIMI[s.v||0];
  if(s.tipo==="griglia"){ const q=domandaGriglia(); return q?q.d:t.des; }
  return t.des;
}

function disegnaSfida(){
  const s=sfida;
  if(modo==="muretto"){
    const w=document.getElementById("mwSfida");
    if(!s||!s.inizio||Date.now()>s.fine+90e3){ w.classList.remove("on"); return; }
    const t=TIPI[s.tipo], c=col(t.c), viva=Date.now()<s.fine;
    w.classList.add("on");
    const tit=w.querySelector(".tit"); tit.textContent=t.nome; tit.style.color=c;
    const fatti=Object.values(griglia).filter(p=>(p.bonus||[]).some(b=>b.sfida===s.id&&b.punti>0)).map(p=>p.nome);
    w.querySelector(".des").innerHTML=esc(testoSfida(s))+(fatti.length?` <span style="color:${c}">· ${esc(fatti.join(", "))}</span>`:"");
    const cd=w.querySelector(".cd");
    cd.textContent=viva?mmss(s.fine-Date.now()):"CHIUSA";
    cd.style.color=viva?c:"var(--testo-3)";
    return;
  }
  const box=document.getElementById("sfidaBox"); if(!box||!io) return;
  if(!s||!s.inizio||Date.now()>s.fine+75e3){ box.innerHTML=""; box.dataset.id=""; return; }
  if(giocoAttivo){ aggiornaCd(box,s); return; }
  const t=TIPI[s.tipo], c=col(t.c), viva=Date.now()<s.fine;
  const mio=(io.bonus||[]).find(b=>b.sfida===s.id);
  const chiave=s.id+(viva?"v":"f")+(mio?"m":"-");
  if(box.dataset.id!==chiave){
    box.dataset.id=chiave;
    let dentro=`<div class="des">${esc(testoSfida(s))}</div>`;
    let q=null;
    if(!mio&&viva){
      if(s.tipo==="quiz") q=QUIZ[s.v||0];
      if(s.tipo==="griglia") q=domandaGriglia();
      if(q) dentro+=q.o.map((o,i)=>`<button class="opz" data-i="${i}">${esc(o)}</button>`).join("");
      if(s.tipo==="prova") dentro+=`<button class="opz" id="fatta">Fatta — prendo i +15</button>`;
      if(s.tipo==="regime") dentro+=`<button class="opz" id="beccato">Mi hanno beccato — −10</button>`;
      if(s.tipo==="reazione") dentro+=`<div id="rz"></div>`;
    }
    const esito=mio?`<div class="esito" style="color:${mio.punti>0?"var(--verde)":"var(--testo-3)"}">${esc(mio.motivo)} · ${mio.punti>0?"+"+mio.punti:mio.punti}</div>`
      :(!viva?`<div class="esito" style="color:var(--testo-3)">Finestra chiusa</div>`:"");
    box.innerHTML=`<div class="sfida" style="border-color:${c}">
      <div class="cap"><span class="tit" style="color:${c}">${t.nome}</span><span class="cd" style="color:${c}">--:--</span></div>
      ${dentro}<div class="barra"><i style="background:${c};width:0"></i></div>${esito}</div>`;
    if(q) box.querySelectorAll(".opz[data-i]").forEach(b=>b.addEventListener("click",()=>rispondi(+b.dataset.i,b,q)));
    const f=box.querySelector("#fatta"); if(f) f.addEventListener("click",()=>premia(s.id,15,"Prova superata"));
    const bc=box.querySelector("#beccato"); if(bc) bc.addEventListener("click",()=>premia(s.id,-10,"Beccato dal regime"));
    const rz=box.querySelector("#rz"); if(rz) semaforo(rz);
  }
  aggiornaCd(box,s);
}
function aggiornaCd(box,s){
  const viva=Date.now()<s.fine;
  const cd=box.querySelector(".cd"), ba=box.querySelector(".barra i");
  if(cd){ cd.textContent=viva?mmss(s.fine-Date.now()):"CHIUSA"; if(!viva) cd.style.color="var(--testo-3)"; }
  if(ba) ba.style.width=viva?Math.max(0,(s.fine-Date.now())/(s.fine-s.inizio)*100)+"%":"0";
}

/* ══ SCHERMO SVEGLIO E MODALITÀ TAVOLO ══ */
let wl=null, vuoleSveglio=false, inRiposo=false;
async function tieniSveglio(on){
  vuoleSveglio=on;
  try{
    if(on){ if(!wl && "wakeLock" in navigator){ wl=await navigator.wakeLock.request("screen"); wl.addEventListener("release",()=>{wl=null}); } }
    else if(wl){ await wl.release(); wl=null; }
  }catch(e){ wl=null; }
  return !!wl;
}
document.addEventListener("visibilitychange",async()=>{
  if(!document.hidden){
    if(vuoleSveglio&&!wl) tieniSveglio(true);
    if(modo) { sincronizza(); ciclaSfide(); }
  }
});

const rp=document.getElementById("riposo");
async function entraRiposo(){
  inRiposo=true; sbloccaAudio();
  const ok=await tieniSveglio(true);
  rp.classList.add("on"); rp.classList.remove("sveglia");
  aggiornaRiposo();
  const b=document.getElementById("riposoBtn");
  if(b&&!ok) b.title="Il browser non concede il blocco schermo";
}
async function esciRiposo(){
  inRiposo=false; rp.classList.remove("on","sveglia");
  await tieniSveglio(false);
  if(tab==="box") disegnaBox();
}
rp.addEventListener("click",esciRiposo);

function aggiornaRiposo(){
  if(!inRiposo||!io) return;
  const st=stato(io), b=BANDIERE[st.bandiera];
  const sveglio=rp.classList.contains("sveglia");
  document.getElementById("rpBac").textContent=st.bac.toFixed(2);
  document.getElementById("rpFl").style.background=sveglio?col(b.c):"#1e2a2f";
  const s=sfida, viva=s&&s.inizio&&Date.now()<s.fine;
  document.getElementById("rpSf").textContent=viva?TIPI[s.tipo].nome:"";
  document.getElementById("rpCd").textContent=viva?mmss(s.fine-Date.now()):"";
}
function svegliaRiposo(){
  if(!inRiposo) return;
  rp.classList.add("sveglia"); aggiornaRiposo();
  setTimeout(()=>{ if(inRiposo){ rp.classList.remove("sveglia"); aggiornaRiposo(); } },25000);
}

/* ── sheet, toast ── */
const velo=document.getElementById("velo"), sheet=document.getElementById("sheet");
function apriSheet(html){document.getElementById("sheetCorpo").innerHTML=html;velo.classList.add("on");sheet.classList.add("on")}
function chiudiSheet(){velo.classList.remove("on");sheet.classList.remove("on")}
velo.addEventListener("click",chiudiSheet);
let tT;
function toast(testo,punti){
  const t=document.getElementById("toast");
  t.querySelector(".tt").textContent=testo;
  const p=t.querySelector(".pp"); p.textContent=punti;
  p.style.color=String(punti).startsWith("-")||String(punti).startsWith("−")?"var(--rossa)":"var(--verde)";
  t.classList.add("on"); clearTimeout(tT); tT=setTimeout(()=>t.classList.remove("on"),2400);
}
function aggiornaConta(){const e=document.getElementById("nPiloti");if(e)e.textContent=Math.max(1,Object.keys(griglia).length)}

/* ── avvio ── */
(async function(){
  const c=await leggi(K_CATALOGO,true);
  if(c&&c.length) catalogo=c; else scrivi(K_CATALOGO,CATALOGO_BASE,true);
  const m=await leggi(K_MODO,false);
  if(m) await entra(m);
  setInterval(()=>{if(modo==="muretto")sincronizza()},3000);
  setInterval(()=>{if(modo)sincronizza()},modo==="muretto"?3000:6000);
  setInterval(()=>{if(modo)ciclaSfide()},8000);
  setInterval(()=>{if(modo)disegnaSfida(); if(inRiposo)aggiornaRiposo();},1000);
  setInterval(()=>{if(modo==="pilota"&&tab==="box"&&io)disegnaBox()},10000);
  document.addEventListener("visibilitychange",()=>{if(!document.hidden&&modo)sincronizza()});
})();
