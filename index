let AC=null;
function sbloccaAudio(){
  try{ if(!AC) AC=new (window.AudioContext||window.webkitAudioContext)(); if(AC.state==="suspended") AC.resume(); }catch(e){}
}
function bip(f,quando,dur,vol=.13,onda="square"){
  if(!AC) return;
  const o=AC.createOscillator(), g=AC.createGain();
  o.type=onda; o.frequency.value=f;
  g.gain.setValueAtTime(0,quando);
  g.gain.linearRampToValueAtTime(vol,quando+.012);
  g.gain.exponentialRampToValueAtTime(.0001,quando+dur);
  o.connect(g); g.connect(AC.destination); o.start(quando); o.stop(quando+dur+.03);
}
function suona(che){
  if(muto) return; sbloccaAudio(); if(!AC) return;
  const t=AC.currentTime;
  if(che==="sfida"){ [880,1174,1568].forEach((f,i)=>bip(f,t+i*.13,.16,.14)); bip(1568,t+.46,.42,.11); }
  if(che==="luce") bip(700,t,.16,.16);
  if(che==="via") bip(1480,t,.5,.18);
  if(che==="ok"){ bip(1046,t,.13); bip(1568,t+.11,.3); }
  if(che==="no"){ bip(220,t,.28,.14,"sawtooth"); }
  if(che==="anticipo"){ bip(180,t,.5,.16,"sawtooth"); }
}

